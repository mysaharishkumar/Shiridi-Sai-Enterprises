# Shiridi Sai Enterprises - Backend Environment Configuration

# Project Metadata
PROJECT_NAME="Shiridi Sai Enterprises"
VERSION="1.0.0"
ENVIRONMENT="production"

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Atlas, use: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="shiridi_sai_enterprises"

# JWT Authentication
# Generate a strong 64-char key in production: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_64_character_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://shiridi-sai-enterprises.onrender.com","*"]

# Media Storage Configuration
# Cloudinary (Optional - if blank, media is saved to local static/uploads directory)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Local File Uploads
UPLOAD_DIR="static/uploads"
STATIC_BASE_URL="/static/uploads"
